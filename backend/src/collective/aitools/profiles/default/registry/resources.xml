<?xml version="1.0" encoding="utf-8"?>
<registry>

  <!-- Classic-UI Patternslib bundle built from resources/ by webpack and
       served under ++plone++collective.aitools (see browser/configure.zcml).
       The remote entry is the webpack module-federation container. -->
  <records interface="Products.CMFPlone.interfaces.IBundleRegistry"
           prefix="plone.bundles/aitools"
  >
    <value key="enabled">True</value>
    <value key="expression" />
    <value key="jscompilation">++plone++collective.aitools/aitools-remote.min.js</value>
    <value key="csscompilation" />
    <value key="load_async">False</value>
    <value key="load_defer">True</value>
  </records>

</registry>
